# Pinned artifacts for the local test server. Sourced by lib.sh.
# Bump deliberately: change version + url + sha256 together, run ./setup.sh, retest.
#
# World: the owner's SimpleWorldDownloader save of the base, DataVersion 4671 = Minecraft 1.21.11.
# A server older than the world cannot load it, so the server runs 1.21.11 and
# ViaVersion + ViaBackwards (server side) let the 1.21.4 ZenithProxy client join.

MC_VERSION="1.21.11"
WORLD_DATA_VERSION="4671"   # DataVersion the pinned server writes; reset-world.sh warns on a newer world

# Paper 1.21.11 build 132, channel STABLE, 2026-05-11 (newest stable 1.21.11 build at pin time).
# Source: https://fill.papermc.io/v3/projects/paper/versions/1.21.11/builds (sha256 from the API).
PAPER_BUILD="132"
PAPER_FILE="paper-1.21.11-132.jar"
PAPER_URL="https://fill-data.papermc.io/v1/objects/5ffef465eeeb5f2a3c23a24419d97c51afd7dbb4923ff42df9a3f58bba1ccfba/paper-1.21.11-132.jar"
PAPER_SHA256="5ffef465eeeb5f2a3c23a24419d97c51afd7dbb4923ff42df9a3f58bba1ccfba"

# GrimAC 2.3.73 (Modrinth project grimac, version_type release, 2026-03-09; supports 1.21.5-1.21.11).
# The GitHub release v2.3.73 has no assets; Modrinth is the official distribution.
# SHA512 is the hash Modrinth publishes; SHA256 was computed from the verified download.
GRIM_VERSION="2.3.73"
GRIM_FILE="grimac-bukkit-2.3.73.jar"
GRIM_URL="https://cdn.modrinth.com/data/LJNGWSvH/versions/1FIGlM6Q/grimac-bukkit-2.3.73.jar"
